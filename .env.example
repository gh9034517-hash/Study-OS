# ─────────────────────────────────────────────────────────────
# StudyOS — variáveis de ambiente do BACKEND (nunca do frontend)
# Copie para ".env" e preencha. O arquivo .env NÃO é versionado.
# ─────────────────────────────────────────────────────────────

# Provedor de IA: gemini (padrão, camada gratuita do Google AI Studio)
#                 groq   (camada gratuita da GroqCloud)
AI_PROVIDER=gemini

# Chave do Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# (Opcional) Chave da GroqCloud: https://console.groq.com/keys
GROQ_API_KEY=

# (Opcional) Sobrescrever o modelo. Padrões:
#   gemini -> gemini-2.5-flash
#   groq   -> llama-3.3-70b-versatile
AI_MODEL=

# Limites de requisição por IP (protege a sua cota gratuita)
RATE_LIMIT_PER_MINUTE=12
RATE_LIMIT_PER_DAY=200

# Porta do servidor local / produção (Render define PORT automaticamente)
PORT=8787
